<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ if title }}{{ title }} - It's Aury{{ else }}It's Aury{{ /if }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href="{{ url |> url(true) }}" />
    <link rel="icon" href="/img/logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <script>document.documentElement.classList.add("js")</script>

    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pixelify-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/silkscreen.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />
    <script type="module" src="/js/backdrop.js"></script>
  </head>
  <body>
    <canvas id="backdrop" aria-hidden="true"></canvas>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-magenta focus:px-4 focus:py-2 focus:font-hud focus:text-xs focus:text-void">Skip to content</a>

    {{ set container }}
      <nav class="holo-panel flex items-center gap-2 px-3 py-2 text-ink" aria-label="Primary">
        <a href="/" class="mr-auto flex items-center gap-2.5 py-1 pr-2" aria-label="Aury, home">
          <img src="/img/logo.png" alt="" width="20" height="28" class="pixelated drop-shadow-[0_0_6px_var(--color-magenta)]" />
          <span class="font-display text-xl leading-none text-glow">Aury</span>
          <span class="hud-label hidden sm:inline text-holo/70">.net</span>
        </a>
        <ul class="hidden md:flex items-center">
          {{ for link of navigation }}
            <li>
              <a href="{{ link.href }}" class="nav-link"{{ if url === link.href || (link.href !== "/" && url.startsWith(link.href)) }} aria-current="page"{{ /if }}>{{ link.name }}</a>
            </li>
          {{ /for }}
        </ul>
        <details class="mobile-menu relative md:hidden">
          <summary class="btn-ghost cursor-pointer !px-3 !py-2">Menu</summary>
          <ul class="holo-panel absolute right-0 top-full mt-3 w-48 bg-void/90 py-2">
            {{ for link of navigation }}
              <li>
                <a href="{{ link.href }}" class="nav-link"{{ if url === link.href || (link.href !== "/" && url.startsWith(link.href)) }} aria-current="page"{{ /if }}>{{ link.name }}</a>
              </li>
            {{ /for }}
          </ul>
        </details>
      </nav>
    {{ /set }}
    <header class="sticky top-0 z-40 pt-3">
      {{ comp.Container({ content: container }) }}
    </header>

    <main id="main" class="pt-6 pb-16">
      {{ content }}
    </main>

    {{ set container }}
      <footer class="pb-10 text-sm">
        <div class="holo-panel mb-5 flex flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 font-hud text-[0.65rem] tracking-widest text-lavender/80 uppercase">
          <span class="flex items-center gap-2 text-holo"><span class="status-dot"></span>System online</span>
          <span>Build <a class="link" href="{{ git.commitUrl }}">{{ git.shortHash || "local" }}</a></span>
          <span>Uptime {{ new Date().getFullYear() - 2018 }}y <span class="text-lavender/50">since 2018</span></span>
          <span class="sm:ml-auto">Support Me <a class="link" href="https://ko-fi.com/aurorahHarmony">Ko-fi</a></span>
          <span>Src <a class="link" href="{{ git.repo }}">GitHub</a></span>
        </div>
        <p class="text-lavender/50">
          &copy; 2018 - {{ new Date().getFullYear() }} Aurorah Harmony. Any and all
          opinions listed here are my own and not representative of my
          employers; future, past and present.
        </p>
      </footer>
    {{ /set }}
    {{ comp.Container({ content: container }) }}
  </body>
</html>
